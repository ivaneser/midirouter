[Unit]
Description=MIDI Router / DAW Looper (midirouter)
After=network-online.target sound.target metronome.service
Wants=network-online.target sound.target
Conflicts=metronome.service

[Service]
Type=simple
User=pi
Group=audio
SupplementaryGroups=audio
AmbientCapabilities=CAP_SYS_RAWIO
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
WorkingDirectory=/home/pi/myprojects/midirouter
ExecStartPre=/bin/sh -c 'sleep 3 && aconnect -l >/dev/null 2>&1 || true'
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
PrivateDevices=no

[Install]
WantedBy=multi-user.target
