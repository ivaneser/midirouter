# Retired. worker-midi.js owns metronome.py as a child process so transport,
# tempo, and meter stay connected to the DAW. Install scripts remove this unit.
[Unit]
Description=Retired standalone MIDI Router metronome

[Service]
Type=simple
User=pi
Group=audio
SupplementaryGroups=audio
AmbientCapabilities=CAP_SYS_RAWIO
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"
WorkingDirectory=/home/pi/myprojects/midirouter
Type=oneshot
ExecStart=/bin/true

[Install]
WantedBy=multi-user.target
