            "categories": [
              "operators"
            ]
          }
        ]
      },
      {
        "title": "Envelopes",
        "hint": "Attack and release of each operator: carriers shape loudness, modulators shape brightness over time.",
        "modules": [
          {
            "title": "Operator envelopes",
            "section": "cc",
            "categories": [
              "envelopes"
            ]
          }
        ]
      },
      {
