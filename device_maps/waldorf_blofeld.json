            "exclude": [
              "Level"
            ],
            "groups": [
              {
                "label": "Pitch",
                "match": [
                  "Octave",
                  "Semitone"
                ]
              },
              {
                "label": "Tone",
                "match": [
                  "Shape",
                  "PW (",
                  "PWM"
                ]
              }
            ]
          },
          {
            "title": "Noise",
            "section": "noise",
            "exclude": [
              "Level"
            ]
          },
          {
            "title": "Mixer",
            "pick": [
              {
                "section": "osc1",
                "name": "Level",
                "label": "Osc 1"
              },
              {
                "section": "osc2",
                "name": "Level",
                "label": "Osc 2"
              },
              {
                "section": "osc3",
                "name": "Level",
                "label": "Osc 3"
              },
              {
                "section": "noise",
                "name": "Level",
                "label": "Noise"
              }
            ]
          }
        ]
      },
      {
        "title": "Filters",
        "hint": "The mixed signal is shaped by two filters. Cutoff and resonance are on the pad; drag it.",
        "modules": [
          {
            "title": "Filter 1",
            "section": "filter1",
            "groups": [
              {
                "label": "Character",
                "match": [
                  "Type",
                  "Drive"
                ]
              },
              {
                "label": "Response",
                "match": [
                  "Keytrack",
                  "Env",
                  "Cutoff Mod",
                  "FM"
                ]
              }
            ]
          },
          {
            "title": "Filter 2",
            "section": "filter2"
          }
        ]
      },
      {
        "title": "Amplifier and effects",
        "hint": "Final level, how hard you play it, and the two effects.",
        "modules": [
          {
            "title": "Amplifier",
            "section": "global",
            "category": "amp"
          },
          {
            "title": "Effects mix",
            "section": "global",
            "category": "fx"
          }
        ]
      },
      {
        "title": "Envelopes",
        "hint": "How the filter and the loudness change over time after a key is pressed. Drag the points on the graphs.",
        "modules": [
          {
            "title": "Filter envelope",
            "section": "env",
            "match": [
              "Filter Env"
            ]
          },
          {
            "title": "Amp envelope",
            "section": "env",
            "match": [
              "Amp Env"
            ]
          }
        ]
      },
      {
        "title": "Modulation",
        "hint": "Slow movement: two LFOs, performance controllers and glide.",
        "modules": [
          {
            "title": "LFO 1",
            "section": "lfo",
            "match": [
              "LFO1"
            ]
          },
          {
            "title": "LFO 2",
            "section": "lfo",
            "match": [
              "LFO2"
            ]
          },
          {
            "title": "Controllers",
            "section": "global",
            "category": "mod"
          },
          {
            "title": "Pitch and glide",
            "section": "global",
            "categories": [
              "pitchmod",
              "glide"
            ]
          }
        ]
      },
      {
        "title": "Arpeggiator",
        "hint": "Plays held notes as a pattern.",
        "modules": [
          {
            "title": "Arpeggiator",
            "section": "arp"
          }
        ]
      }
    ]
  }
