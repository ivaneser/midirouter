  "ui": {
    "stages": [
      {
        "title": "Sound source",
        "hint": "Three oscillators and noise make the raw tone; the mixer sets how much of each goes to the filters.",
        "modules": [
          {
            "title": "Oscillator 1",
            "section": "osc1",
            "exclude": [
              "Level"
            ],
            "groups": [
              {
                "label": "Pitch",
                "match": [
                  "Octave",
                  "Semitone",
                  "Detune"
                ]
              },
              {
                "label": "Tone",
                "match": [
                  "Shape",
                  "PW (",
                  "PWM"
                ]
              },
              {
                "label": "FM",
                "match": [
                  "FM"
                ]
