  "ui": {
    "stages": [
      {
        "title": "Sound source",
        "modules": [
          {
            "title": "Oscillator",
            "categories": [
              "osc"
            ],
            "exclude": [
              "Volume EG"
            ],
            "groups": [
              {
                "label": "Type",
                "match": [
                  "Osc Type"
                ]
              },
              {
                "label": "Tone",
                "match": [
                  "Wave Shaping",
                  "Alt"
                ]
              }
            ]
          }
        ]
      },
      {
        "title": "Filter",
        "modules": [
          {
            "title": "Filter",
            "categories": [
              "filter"
            ]
