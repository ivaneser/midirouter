      "min": 0,
      "max": 127,
      "type": "slider",
      "unit": "%",
      "category": "reverb",
      "description": "Reverb depth"
    },
    {
      "cc": 36,
      "name": "Reverb Mix",
      "min": 0,
      "max": 127,
      "type": "slider",
      "unit": "dry/wet",
      "category": "fx",
      "description": "Reverb dry/wet balance"
    },
    {
      "cc": 42,
      "name": "Filter Type",
      "min": 0,
      "max": 6,
      "type": "dropdown",
      "options": [
        "LP2",
        "LP4",
        "BP2",
        "BP4",
        "HP2",
        "HP4",
        "Off"
      ],
      "category": "filter",
      "description": "Filter type. 7 zones of ~18.3, all verified acoustically 2025-10-03: LP2 strong, LP4 weaker, BP2/BP4 band (high centroid, weak), HP2/HP4 (no fundamental, highest centroid), Thru (raw osc).",
      "zones": {
        "0": "Lowpass 2-pole",
        "28": "Lowpass 4-pole",
        "47": "Bandpass 2-pole",
        "66": "Bandpass 4-pole",
        "85": "Highpass 2-pole",
        "104": "Highpass 4-pole",
        "120": "Thru"
      },
      "values": [
        0,
        28,
        47,
        66,
        85,
        104,
        120
      ]
    },
    {
      "cc": 43,
      "name": "Cutoff",
      "min": 0,
      "max": 127,
      "type": "slider",
      "unit": "freq",
      "category": "filter",
      "primary": true,
      "description": "Cutoff frequency"
    },
    {
      "cc": 44,
      "name": "Resonance",
      "min": 0,
      "max": 127,
      "type": "slider",
      "unit": "%",
      "category": "filter",
      "description": "Resonance"
    },
    {
      "cc": 45,
      "name": "Sweep Depth",
      "min": 0,
      "max": 127,
      "type": "slider",
      "unit": "%",
      "category": "sweep",
      "description": "Cutoff sweep depth: 0-62 up, 63 none, 64-127 down",
      "center": 63
    },
    {
      "cc": 46,
      "name": "Sweep Cutoff",
      "min": 0,
      "max": 127,
      "type": "slider",
      "unit": "freq",
      "category": "sweep",
      "description": "Cutoff sweep rate F0.0-F30.0"
    },
    {
      "cc": 53,
      "name": "Osc Type",
      "min": 0,
      "max": 4,
      "type": "dropdown",
      "options": [
        "Saw",
        "Tri",
        "Square",
        "VPM",
        "Waves"
      ],
      "category": "osc",
      "description": "Oscillator type. Zones verified empirically (spectral probing, 2025-10-03): 0-19 sawtooth, 20-44 triangle, 45-69 square, 70-99 VPM, 100-127 noise (user waves live at the top, acoustically indistinguishable with factory user OSC; 'Off' is not CC-addressable)",
      "zones": {
        "0": "Sawtooth",
        "25": "Triangle",
        "50": "Square",
        "75": "VPM",
        "105": "Noise"
      },
      "values": [
        0,
        25,
        50,
        75,
        115
      ]
    },
    {
      "cc": 54,
      "name": "Wave Shaping",
      "min": 0,
      "max": 127,
      "type": "slider",
      "unit": "%",
      "category": "osc",
      "description": "Wave-shaping amount"
    },
    {
      "cc": 55,
      "name": "Alt",
      "min": 0,
      "max": 127,
      "type": "slider",
      "unit": "%",
      "category": "osc",
      "description": "Oscillator alternate"
    },
    {
      "cc": 88,
      "name": "FX Mod Type",
      "min": 0,
      "max": 5,
      "type": "dropdown",
      "options": [
        "Off",
        "Chorus",
        "Ensemble",
        "Phaser",
        "Flanger",
        "Fuzz"
      ],
      "category": "fx_mod",
      "description": "Modulation FX type. Probe 2025-10-03: 0-21 is dry (Off), then 5 wet zones of ~21.3: ~22-42 chorus/ensemble family, ~43-63 (more voices), ~64-84 comb (lowest centroid = phaser), ~85-105 flanger family, ~106-127 clipping (max RMS, lowest centroid = fuzz). Names follow manual order (OFF, Chorus, Ensemble, Phaser, Flanger, Soft Clip, Hard Clip, Sine Fold, Fuzz); the 9 names collapse into 6 CC zones, so middle identities are approximate.",
      "zones": {
        "0": "Off",
        "32": "Chorus*",
        "53": "Ensemble*",
        "74": "Phaser*",
        "95": "Flanger*",
        "116": "Clipping (fuzz family)*"
      },
      "values": [
        0,
        32,
        53,
        74,
        95,
        116
      ]
    },
    {
      "cc": 89,
      "name": "FX Delay Type",
      "min": 0,
      "max": 5,
      "type": "dropdown",
      "options": [
        "Off",
        "Stereo",
        "Mono",
        "Ping Pong",
        "High Pass",
        "Tape"
      ],
      "category": "fx_delay",
      "description": "Delay type. 7-slot scheme (step ~127/6), per midi.guide/d/korg/nts-1 community table: 0: Off, 21: Stereo, 42: Mono, 63: Ping Pong, 84: High Pass, 127: Tape. CC89=22 showing 'Stereo' on the display (2026-10-03) matches the 21-41 Stereo slot. The 105-126 slot is unnamed in the source (manual lists 12 types incl. One, *BPM variants, Doubling); KORG itself documents no CC ranges.",
      "zones": {
        "0": "Off",
        "21": "Stereo",
        "42": "Mono",
        "63": "Ping Pong",
        "84": "High Pass",
        "105": "unknown (unnamed in source - One/*BPM/Doubling region)",
        "127": "Tape"
      },
      "values": [
        0,
        21,
        42,
        63,
        84,
        127
      ]
    },
    {
      "cc": 90,
      "name": "FX Reverb Type",
      "min": 0,
      "max": 9,
      "type": "dropdown",
      "options": [
        "Hall",
        "Smooth",
        "Arena",
        "Plate",
        "Room",
        "Early",
        "Space",
        "Riser",
        "Submarine",
        "Horror"
      ],
      "category": "fx_reverb",
      "description": "Reverb type. Manual lists 11 (OFF + 10); 'OFF' is not CC-addressable (CC90=0 is already wet). 10 zones of ~12.8 in manual order. Probe 2025-10-03: lowest centroids at the top (104-116 Submarine / 117-127 Horror confirmed by measurement); dense early-reflection spike around ~80 (Early/Space region); others approximate.",
      "zones": {
        "0": "Hall*",
        "13": "Smooth*",
        "26": "Arena*",
        "39": "Plate*",
        "52": "Room*",
        "65": "Early*",
        "78": "Space*",
        "91": "Riser*",
        "104": "Submarine",
        "117": "Horror"
      },
      "values": [
        0,
        13,
        26,
        39,
        52,
        65,
        78,
        91,
        104,
        117
      ]
    },
