{
  "manufacturer": "Korg",
  "model": "NTS-1",
  "type": "digital synth + DSP effects",
  "midi_version": "2.0",
  "controls": [
    {
      "cc": 14,
      "name": "Volume EG Type",
      "min": 0,
      "max": 4,
      "type": "dropdown",
      "options": [
        "ADSR",
        "AHR",
        "AR",
        "AR loop",
        "Open"
      ],
      "category": "osc",
      "description": "EG type. Zones measured 2025-10-03 (held C5, burst/constancy analysis): 0-25 ADSR, 26-51 AHR, 52-76 shows repeating bursts (AR Loop), 77-102 single decay (AR), 103-127 constant (Open). NOTE: the 52-76/77-102 pair is inverted relative to the knob order in the manual - trust the acoustic labels.",
      "zones": {
        "0": "ADSR",
        "38": "AHR",
        "64": "AR Loop (acoustic)",
        "90": "AR (acoustic)",
        "115": "Open"
      },
      "values": [
        0,
        38,
        90,
        64,
        115
      ]
    },
    {
      "cc": 16,
      "name": "Attack",
      "min": 0,
      "max": 127,
